<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>IPTV Test</title>

<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
}

#player {
    width: 100%;
    height: 100%;
    background: #000;
}
</style>

</head>
<body>

<video
    id="player"
    autoplay
    muted
    controls>
</video>

<script>
const player = document.getElementById("player");

player.src = "udp://239.255.0.9:1234";

console.log("Loading stream:", player.src);

player.addEventListener("error", function(event) {
    console.log("Video error:", event);
});

player.addEventListener("loadedmetadata", function() {
    console.log("Metadata loaded");
});

player.addEventListener("playing", function() {
    console.log("Playback started");
});
</script>

</body>
</html>
